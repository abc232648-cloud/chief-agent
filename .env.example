# Supply your own credentials. This file contains no saved secrets.
GROQ_API_KEY=
MISTRAL_API_KEY=
QWEN_MODEL=qwen/qwen3.8-27b
MISTRAL_MODEL=mistral-small-latest
FREE_ONLY=TRUE
MISTRAL_PAID_ALLOWED=FALSE
DASHBOARD_HOST=127.0.0.1
# Set TRUE only on your real deployment when ready for personal sign-in.
CHIEF_ALLOW_INTERACTIVE_LOGIN=FALSE
EMAIL_PROVIDER=custom_smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENT=

# Optional Job companion Web Push.
# Public VAPID application-server key and contact claim are safe configuration.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=
# Production must use the private-secret reference. Do not place the private key here.
WEB_PUSH_VAPID_PRIVATE_KEY_REF=
# Preview/development compatibility only; production refuses plaintext private-key use.
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional comma-separated exact provider hosts in addition to Chief's built-in allow-list.
WEB_PUSH_ALLOWED_HOSTS=
