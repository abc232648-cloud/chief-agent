# Supply your own credentials. This file contains no saved secrets.
GROQ_API_KEY=
MISTRAL_API_KEY=
QWEN_MODEL=qwen/qwen3.8-27b
MISTRAL_MODEL=mistral-small-latest
FREE_ONLY=TRUE
MISTRAL_PAID_ALLOWED=FALSE
DASHBOARD_HOST=127.0.0.1
# Set TRUE only on your real deployment when ready for personal sign-in.
CHIEF_ALLOW_INTERACTIVE_LOGIN=FALSE
EMAIL_PROVIDER=custom_smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENT=
# Job Agent Web Push. In production set CHIEF_WEB_PUSH_PRIVATE_KEY_REF instead
# of plaintext CHIEF_WEB_PUSH_PRIVATE_KEY and provision it through Chief's
# existing secret-reference mechanism.
CHIEF_WEB_PUSH_PUBLIC_KEY=
CHIEF_WEB_PUSH_PRIVATE_KEY=
CHIEF_WEB_PUSH_PRIVATE_KEY_REF=
CHIEF_WEB_PUSH_SUBJECT=
